# Example for LOCAL development only (vercel dev)
# Copy to .env.local (gitignored) and fill with SANDBOX values for safe local testing.
# NEVER put live credentials here for prolonged use. Use sandbox for dev.

PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# For live local testing (risky, real money): use live values + live mode temporarily.
# After testing, rotate secrets.